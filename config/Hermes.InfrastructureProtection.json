{
    "Version": "1.0.0",
    "PolicyName": "Hermes Azure Infrastructure Protection Policy",
    "Description": "Centralized protection policy preventing accidental destruction of shared Azure infrastructure",
    "Enforcement": "hard",
    "Created": "2026-08-07",
    "ProtectedResourceGroups": [
        "RG-Hermes-Proyectos",
        "RG-Datamining-SII2.0-Dev"
    ],
    "ProtectedAppServicePlans": [
        "ASP-IAUR",
        "Plan-Hermes-Proyectos"
    ],
    "ProtectedStorageAccounts": [
        "saurhermesproyectos"
    ],
    "ProtectedKeyVaults": [],
    "RequiredTags": {
        "HermesManaged": "true"
    },
    "BlockedOperations": [
        "Remove-AzureRmResourceGroup",
        "Remove-AzResourceGroup",
        "az group delete"
    ],
    "ValidationRules": {
        "RequireHermesOrigin": true,
        "RequireProjectOwnership": true,
        "DenySharedInfrastructureDeletion": true,
        "DenyProtectedResourceGroupDeletion": true,
        "DenyProtectedAppServicePlanDeletion": true,
        "DenyProtectedStorageDeletion": true,
        "DenyUntaggedResourceDeletion": true,
        "RequireDependencyCheck": true
    },
    "Audit": {
        "LogAllAttempts": true,
        "LogToSQLite": true,
        "LogToTelemetry": true,
        "SeverityLevel": "Critical"
    }
}