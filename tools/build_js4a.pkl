function renderEventLog(events){var con=document.getElementById('event-log-container');con.innerHTML='';if(!events||events.length===0){con.innerHTML='<div class="text-center text-muted py-3">No hay eventos que coincidan con los filtros.</div>';return}
for(var i=0;i<events.length;i++){var ev=events[i];var t=(ev.tipo||'INFO').toUpperCase();var ec='event-info',bc='badge-info';if(t==='PASS'){ec='event-pass';bc='badge-pass'}else if(t==='WARN'){ec='event-warn';bc='badge-warn'}else if(t==='ERROR'||t==='FAIL'){ec='event-error';bc='badge-error'}
var div=document.createElement('div');div.className=ec+' rounded p-2 mb-1 clickable fade-in';var ts=formatTSshort(ev.timestamp)||'---';var pas=ev.paso_numero?'PASO '+ev.paso_numero:'';var pn=ev.paso_nombre||'';
div.innerHTML='<div class="d-flex justify-content-between align-items-center" onclick="toggleEventDetail(this)"><div class="small"><span class="text-muted">['+ts+']</span> <span class="badge '+bc+' me-1" style="font-size:0.65rem">'+t+'</span>'+(pas?'<span class="badge bg-dark me-1" style="font-size:0.65rem">'+pas+'</span>':'')+(pn?'<span class="badge bg-dark me-1" style="font-size:0.65rem">'+pn+'</span>':'')+'<span class="text-light">'+(ev.mensaje||'')+'</span></div><i class="bi bi-chevron-down text-muted" style="font-size:0.7rem"></i></div>';
var det=document.createElement('div');det.className='event-detail-panel p-3 mt-1 mb-2 d-none small';
var hi=(ev.http_method||'')+' '+(ev.http_url||'');if(ev.http_status)hi+=' ['+ev.http_status+']';
var ru=ev.run_url?'<a href="'+ev.run_url+'" target="_blank" class="text-info">'+ev.run_url+'</a>':'---';
det.innerHTML='<div class="row"><div class="col-md-6 mb-1"><span class="text-muted">Timestamp:</span> <span class="text-light">'+(ev.timestamp||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Paso:</span> <span class="text-light">'+(ev.paso_numero?ev.paso_numero+' - '+(ev.paso_nombre||''):'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Subpaso:</span> <span class="text-light">'+(ev.subpaso_nombre||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Componente:</span> <span class="text-light">'+(ev.componente||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Actor:</span> <span class="text-light">'+(ev.actor||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Estado anterior:</span> <span class="text-light">'+(ev.estado_anterior||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Estado nuevo:</span> <span class="text-light">'+(ev.estado_nuevo||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Mensaje:</span> <span class="text-light">'+(ev.mensaje||'---')+'</span></div><div class="col-12 mb-1"><span class="text-muted">Detalle:</span> <span class="text-light">'+(ev.detalle||'---')+'</span></div><div class="col-12 mb-1"><span class="text-muted">Evidencia:</span> <span class="text-light">'+(ev.evidencia||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">HTTP:</span> <span class="text-light">'+hi+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Run ID:</span> <span class="text-light">'+(ev.run_id||'---')+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Run URL:</span> <span class="text-light">'+ru+'</span></div><div class="col-md-6 mb-1"><span class="text-muted">Error:</span> <span class="text-danger">'+(ev.error_message||'---')+'</span></div><div class="col-12 mt-1"><span class="text-muted">Fase:</span> <span class="text-light">'+(ev.fase||'---')+'</span></div></div>';
div.appendChild(det);con.appendChild(div)}}
function toggleEventDetail(el){var d=el.parentElement.querySelector('.event-detail-panel');if(!d)return;var a=el.querySelector('.bi-chevron-down,.bi-chevron-up');d.classList.toggle('d-none');if(a)a.className=d.classList.contains('d-none')?'bi bi-chevron-down text-muted':'bi bi-chevron-up text-muted'}
function iniciarPolling(){if(refreshInterval)return;var c=0;refreshInterval=setInterval(function(){c++;document.getElementById('polling-text').textContent=(c*5)+'s';cargarDatos()},5000)}
function detenerPolling(){if(refreshInterval){clearInterval(refreshInterval);refreshInterval=null}document.getElementById('polling-text').textContent='Completado';document.getElementById('auto-refresh-status').innerHTML='<i class="bi bi-check-circle me-1 text-success"></i>Completado'}
